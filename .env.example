# App runtime
ENVIRONMENT=development
PORT=8000

# MongoDB
MONGO_URI=mongodb://localhost:27017/rag_brain
MONGO_DB_NAME=rag_brain

# JWT auth
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenAI
OPENAI_API_KEY=
OPENAI_QNA_MODEL=gpt-5.4-mini

# Embeddings
# Supported values: openai, huggingface
# Use openai with requirements.txt. Use huggingface with requirements-local-embeddings.txt too.
LLAMA_EMBED_PROVIDER=openai
LLAMA_COLLECTION_NAME=qa_collection
LLAMA_EMBED_MODEL=VoVanPhuc/sup-SimCSE-VietNamese-phobert-base
OPENAI_EMBED_MODEL=text-embedding-3-small

# Persistent RAG storage
# Set STORAGE_ROOT on production volumes, for example /app/data on Railway.
STORAGE_ROOT=
RAILWAY_VOLUME_MOUNT_PATH=
LLAMA_CHROMA_PERSIST_DIR=
BM25_PERSIST_DIR=
DOCSTORE_PERSIST_DIR=

# HuggingFace cache for local embeddings
HF_HOME=./hf_cache
TRANSFORMERS_CACHE=./hf_cache
HF_HUB_CACHE=./hf_cache

# OpenClaw shared-key access
RAG_BRAIN_OPENCLAW_API_KEY=

# Credit Agent FastMCP adapter
RAG_MCP_USER_ID=
LOAN_AGENT_MCP_USER_ID=
RAG_MCP_HOST=127.0.0.1
RAG_MCP_PORT=8766

# Temporary upload workspace
TEMP_KB_DIR=tmp/knowledge_base

# Loan-agent uploaded documents
# Defaults to STORAGE_ROOT/loan_uploads when STORAGE_ROOT is set, otherwise ./loan_uploads.
LOAN_UPLOAD_DIR=
